# OctalFlow deployment environment
# Docker: copy this file to .env in the repository root.
# Source development: copy it to web/.env.local and change DATABASE_URL host to localhost.

# Required public URL. Production should use the externally reachable HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional image override. The default Compose release is pinned; use octalaicanvas:local when building on the server.
OCTALAICANVAS_IMAGE=ghcr.io/dreamwho/octalaicanvas:v0.0.6

# Default Docker Compose creates this PostgreSQL database and overrides DATABASE_URL with host `postgres`.
POSTGRES_DB=octalaicanvas
POSTGRES_USER=octalaicanvas
POSTGRES_PASSWORD=

# Source deployment and external PostgreSQL connection.
OCTALAICANVAS_DATABASE_PROVIDER=postgres
DATABASE_URL=
OCTALAICANVAS_DATABASE_POOL_MAX=10
# Local/Docker PostgreSQL normally uses 0. Managed cloud PostgreSQL commonly requires 1.
OCTALAICANVAS_DATABASE_SSL=0
# TLS verification defaults to enabled. Only set 0 for a provider that cannot supply a trusted certificate.
OCTALAICANVAS_DATABASE_SSL_REJECT_UNAUTHORIZED=1
# Optional PEM CA certificate. In single-line env files encode line breaks as \n.
OCTALAICANVAS_DATABASE_SSL_CA=

# Required in production. Must be 64 hexadecimal characters or exact 32-byte Base64.
# Generate once with `openssl rand -hex 32`, keep it stable, and never commit the real value.
OCTALAICANVAS_ENCRYPTION_KEY=

# Required only until the first administrator is created. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`; keep it server-side and remove it after installation completes.
OCTALAICANVAS_INSTALL_TOKEN=

# Runtime paths and internal callbacks.
OCTALAICANVAS_DATA_DIR=/app/web/.data
OCTALAICANVAS_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Leave empty for automatic HTTP/HTTPS detection. Set true or false only for unusual proxies.
OCTALAICANVAS_COOKIE_SECURE=
# Reverse proxy hop count used for rate limiting client IPs. Set 1 for one trusted proxy.
OCTALAICANVAS_TRUSTED_PROXY_HOPS=0
# Optional local override when FFmpeg is not on PATH. Docker images already include FFmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy used by server-side model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Mihomo magic-proxy runtime. Compose supplies topology-specific controller and
# listener URLs; keep the controller secret server-side and generate it once.
OCTALAICANVAS_MAGIC_PROXY_IMAGE=metacubex/mihomo:v1.19.30
OCTALAICANVAS_MAGIC_PROXY_SECRET=
OCTALAICANVAS_MAGIC_PROXY_CONTROLLER_URL=
OCTALAICANVAS_MAGIC_PROXY_GEMINIAI_URL=
OCTALAICANVAS_MAGIC_PROXY_GEMINI_TOOLS_URL=
OCTALAICANVAS_MAGIC_PROXY_LISTEN_HOST=
OCTALAICANVAS_MAGIC_PROXY_GEMINIAI_PORT=
OCTALAICANVAS_MAGIC_PROXY_GEMINI_TOOLS_PORT=
# Docker Compose supplies the private shared-volume path; do not expose it to browser clients.
OCTALAICANVAS_MAGIC_PROXY_PROVIDER_FILE=
# Optional subscription response resource limit; defaults to 4194304 bytes (4 MiB).
OCTALAICANVAS_MAGIC_PROXY_MAX_SUBSCRIPTION_BYTES=
# Subscription URLs are encrypted and stored through the admin UI; do not put
# a subscription URL in this file or in a deployment package.

# GeminiAI sidecar: Docker Compose keeps this provider on its internal network
# (宝塔 host-network mode binds it to 127.0.0.1 only). Generate a dedicated
# value with `openssl rand -hex 32`; it must not be sent to browser clients.
OCTALAICANVAS_GEMINIAI_IMAGE=octalaicanvas-geminiai:local
OCTALAICANVAS_GEMINIAI_API_KEY=
# Docker Compose supplies the internal URL. Only source development should set
# this manually after starting a trusted local sidecar.
OCTALAICANVAS_GEMINIAI_URL=
# 可选：固定浏览器反代使用的 AI Studio 项目上下文，不需要 API Key
OCTALAICANVAS_GEMINIAI_STUDIO_URL=https://aistudio.google.com/prompts/new_chat?project=your-project-id

# GeminiTools uses the reference project's built-in Antigravity Enterprise OAuth
# client in the current browser popup. These two values are optional overrides.
GEMINI_TOOLS_OAUTH_CLIENT_ID=
GEMINI_TOOLS_OAUTH_CLIENT_SECRET=
# Optional with a custom OAuth client when the public callback differs from APP_URL.
GEMINI_TOOLS_OAUTH_REDIRECT_URI=

# 即梦官方 CLI 由 Web/Generation Worker 所在的服务账号本地执行。
# 留空时从 PATH 查找 dreamina；自定义位置必须填写绝对可执行文件路径。
OCTALAICANVAS_DREAMINA_CLI_PATH=
# 可选：受控素材暂存与异步结果下载目录；必须为绝对路径，默认使用系统临时目录。
OCTALAICANVAS_DREAMINA_CLI_TEMP_ROOT=

# Private or loopback model providers are blocked by default. Enable only for administrator-controlled hosts.
# Hosts are exact, comma-separated names or IP addresses; do not add cloud metadata or link-local addresses.
OCTALAICANVAS_ALLOW_PRIVATE_UPSTREAMS=0
OCTALAICANVAS_PRIVATE_UPSTREAM_HOSTS=

# Billing behavior.
OCTALAICANVAS_BILLING_ORDER_EXPIRES_MINUTES=30
# Optional token for deployment-neutral maintenance jobs. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`, then call maintenance APIs with `Authorization: Bearer <token>`.
OCTALAICANVAS_MAINTENANCE_TOKEN=
# Required by the generation Worker and internal per-user task callbacks. It must differ from the maintenance token.
OCTALAICANVAS_WORKER_TOKEN=
# Worker polls the internal endpoint. Docker Compose sets this to http://app:3000.
OCTALAICANVAS_WORKER_API_ORIGIN=
OCTALAICANVAS_GENERATION_WORKER_ID=
# Initial idle polling interval. Consecutive empty batches back off to 10000ms.
OCTALAICANVAS_GENERATION_WORKER_INTERVAL_MS=2000
OCTALAICANVAS_GENERATION_WORKER_LANES=2
OCTALAICANVAS_GENERATION_WORKER_HEARTBEAT_MS=15000
OCTALAICANVAS_GENERATION_WORKER_STALE_MS=90000

# Optional work-publication moderation signal provider. Signals never auto-approve content.
# manual: always requires an administrator review (default).
# keywords: checks the comma/newline-separated keyword list below.
# http: POSTs public draft fields to the configured endpoint with a 3-second timeout.
OCTALAICANVAS_CONTENT_MODERATION_PROVIDER=manual
OCTALAICANVAS_CONTENT_MODERATION_KEYWORDS=
OCTALAICANVAS_CONTENT_MODERATION_URL=
OCTALAICANVAS_CONTENT_MODERATION_API_KEY=

# Optional Stripe configuration. It can also be saved from the admin payment settings page.
OCTALAICANVAS_STRIPE_SECRET_KEY=
OCTALAICANVAS_STRIPE_WEBHOOK_SECRET=
OCTALAICANVAS_STRIPE_API_BASE=https://api.stripe.com
OCTALAICANVAS_STRIPE_SUCCESS_URL=
OCTALAICANVAS_STRIPE_CANCEL_URL=
OCTALAICANVAS_STRIPE_PAYMENT_METHOD_TYPES=
OCTALAICANVAS_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional Alipay configuration.
OCTALAICANVAS_ALIPAY_MODE=official
OCTALAICANVAS_ALIPAY_APP_ID=
OCTALAICANVAS_ALIPAY_PRIVATE_KEY=
OCTALAICANVAS_ALIPAY_PRIVATE_KEY_PATH=
OCTALAICANVAS_ALIPAY_PUBLIC_KEY=
OCTALAICANVAS_ALIPAY_PUBLIC_KEY_PATH=
OCTALAICANVAS_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
OCTALAICANVAS_ALIPAY_NOTIFY_URL=
OCTALAICANVAS_ALIPAY_RETURN_URL=

# Optional WeChat Pay v3 configuration.
OCTALAICANVAS_WECHAT_PAY_APP_ID=
OCTALAICANVAS_WECHAT_PAY_MCH_ID=
OCTALAICANVAS_WECHAT_PAY_CERT_SERIAL_NO=
OCTALAICANVAS_WECHAT_PAY_PRIVATE_KEY=
OCTALAICANVAS_WECHAT_PAY_PRIVATE_KEY_PATH=
OCTALAICANVAS_WECHAT_PAY_API_V3_KEY=
OCTALAICANVAS_WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
OCTALAICANVAS_WECHAT_PAY_PLATFORM_PUBLIC_KEY=
OCTALAICANVAS_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
OCTALAICANVAS_WECHAT_PAY_PLATFORM_CERTIFICATE=
OCTALAICANVAS_WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
OCTALAICANVAS_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
OCTALAICANVAS_WECHAT_PAY_NOTIFY_URL=
OCTALAICANVAS_WECHAT_PAY_REFUND_NOTIFY_URL=
OCTALAICANVAS_WECHAT_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# Optional PayPly/custom gateway configuration.
OCTALAICANVAS_PAYPLY_CHECKOUT_URL=
OCTALAICANVAS_PAYPLY_REFUND_URL=
OCTALAICANVAS_PAYPLY_API_KEY=
OCTALAICANVAS_PAYPLY_API_KEY_HEADER=
OCTALAICANVAS_PAYPLY_MERCHANT_ID=
OCTALAICANVAS_PAYPLY_REQUEST_METHOD=POST
OCTALAICANVAS_PAYPLY_CONTENT_TYPE=application/json
OCTALAICANVAS_PAYPLY_EXTRA_HEADERS=
OCTALAICANVAS_PAYPLY_REQUEST_TEMPLATE=
OCTALAICANVAS_PAYPLY_NOTIFY_URL=
OCTALAICANVAS_PAYPLY_RETURN_URL=
OCTALAICANVAS_PAYPLY_CANCEL_URL=
OCTALAICANVAS_PAYPLY_RESULT_KIND=
OCTALAICANVAS_PAYPLY_URL_FIELD=data.payUrl
OCTALAICANVAS_PAYPLY_QR_FIELD=data.qrContent
OCTALAICANVAS_PAYPLY_FORM_FIELD=data.formHtml
OCTALAICANVAS_PAYPLY_PROVIDER_ORDER_ID_FIELD=data.tradeId
OCTALAICANVAS_PAYPLY_PROVIDER_PAYMENT_ID_FIELD=data.paymentId
OCTALAICANVAS_PAYPLY_WEBHOOK_SECRET=
OCTALAICANVAS_PAYPLY_WEBHOOK_SIGNATURE_HEADER=x-signature
OCTALAICANVAS_PAYPLY_WEBHOOK_EVENT_ID_FIELD=id
OCTALAICANVAS_PAYPLY_WEBHOOK_EVENT_TYPE_FIELD=type
OCTALAICANVAS_PAYPLY_WEBHOOK_ORDER_ID_FIELD=data.orderId
OCTALAICANVAS_PAYPLY_WEBHOOK_ORDER_NO_FIELD=data.orderNo
OCTALAICANVAS_PAYPLY_WEBHOOK_STATUS_FIELD=data.status
OCTALAICANVAS_PAYPLY_WEBHOOK_SUCCESS_STATUSES=paid,success,succeeded,completed
OCTALAICANVAS_PAYPLY_WEBHOOK_TRADE_ID_FIELD=data.tradeId
OCTALAICANVAS_PAYPLY_WEBHOOK_PAYMENT_ID_FIELD=data.paymentId
OCTALAICANVAS_PAYPLY_WEBHOOK_AMOUNT_CENTS_FIELD=data.amountCents
OCTALAICANVAS_PAYPLY_WEBHOOK_AMOUNT_YUAN_FIELD=data.amount
OCTALAICANVAS_PAYPLY_WEBHOOK_CURRENCY_FIELD=data.currency
OCTALAICANVAS_PAYPLY_WEBHOOK_PAID_AT_FIELD=data.paidAt
OCTALAICANVAS_PAYPLY_REFUND_REQUEST_METHOD=POST
OCTALAICANVAS_PAYPLY_REFUND_CONTENT_TYPE=application/json
OCTALAICANVAS_PAYPLY_REFUND_EXTRA_HEADERS=
OCTALAICANVAS_PAYPLY_REFUND_REQUEST_TEMPLATE=
OCTALAICANVAS_PAYPLY_REFUND_ID_FIELD=data.refundId
OCTALAICANVAS_PAYPLY_REFUND_STATUS_FIELD=data.status
OCTALAICANVAS_PAYPLY_REFUND_SUCCESS_STATUSES=refunded,success,succeeded

# Generic signed callback fallback for /api/billing/webhooks/custom.
OCTALAICANVAS_PAYMENT_WEBHOOK_SECRET=
