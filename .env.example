# dreamyo deployment environment
# Docker: copy this file to .env in the repository root.
# Source development: copy it to web/.env.local and change DATABASE_URL host to localhost.

# Required public URL. Production should use the externally reachable HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional image override. The default Compose release is pinned; use dreamyo:local when building on the server.
DREAMYO_IMAGE=ghcr.io/dreamwho/dreamyo:v0.0.6

# Default Docker Compose creates this PostgreSQL database and overrides DATABASE_URL with host `postgres`.
POSTGRES_DB=dreamyo
POSTGRES_USER=dreamyo
POSTGRES_PASSWORD=

# Source deployment and external PostgreSQL connection.
DREAMYO_DATABASE_PROVIDER=postgres
DATABASE_URL=
DREAMYO_DATABASE_POOL_MAX=10
# Local/Docker PostgreSQL normally uses 0. Managed cloud PostgreSQL commonly requires 1.
DREAMYO_DATABASE_SSL=0
# TLS verification defaults to enabled. Only set 0 for a provider that cannot supply a trusted certificate.
DREAMYO_DATABASE_SSL_REJECT_UNAUTHORIZED=1
# Optional PEM CA certificate. In single-line env files encode line breaks as \n.
DREAMYO_DATABASE_SSL_CA=

# Required in production. Must be 64 hexadecimal characters or exact 32-byte Base64.
# Generate once with `openssl rand -hex 32`, keep it stable, and never commit the real value.
DREAMYO_ENCRYPTION_KEY=

# Required only until the first administrator is created. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`; keep it server-side and remove it after installation completes.
DREAMYO_INSTALL_TOKEN=

# Runtime paths and internal callbacks.
DREAMYO_DATA_DIR=/app/web/.data
DREAMYO_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Leave empty for automatic HTTP/HTTPS detection. Set true or false only for unusual proxies.
DREAMYO_COOKIE_SECURE=
# Reverse proxy hop count used for rate limiting client IPs. Set 1 for one trusted proxy.
DREAMYO_TRUSTED_PROXY_HOPS=0
# Optional local override when FFmpeg is not on PATH. Docker images already include FFmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy used by server-side model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Mihomo magic-proxy runtime. Compose supplies topology-specific controller and
# listener URLs; keep the controller secret server-side and generate it once.
DREAMYO_MAGIC_PROXY_IMAGE=metacubex/mihomo:v1.19.30
DREAMYO_MAGIC_PROXY_SECRET=
DREAMYO_MAGIC_PROXY_CONTROLLER_URL=
DREAMYO_MAGIC_PROXY_GEMINIAI_URL=
DREAMYO_MAGIC_PROXY_GEMINI_TOOLS_URL=
DREAMYO_MAGIC_PROXY_LISTEN_HOST=
DREAMYO_MAGIC_PROXY_GEMINIAI_PORT=
DREAMYO_MAGIC_PROXY_GEMINI_TOOLS_PORT=
DREAMYO_MAGIC_PROXY_CHATGPT_API_PORT=
DREAMYO_MAGIC_PROXY_CHATGPT_API_URL=
# Docker Compose supplies the private shared-volume path; do not expose it to browser clients.
DREAMYO_MAGIC_PROXY_PROVIDER_FILE=
# Optional subscription response resource limit; defaults to 4194304 bytes (4 MiB).
DREAMYO_MAGIC_PROXY_MAX_SUBSCRIPTION_BYTES=
# Subscription URLs are encrypted and stored through the admin UI; do not put
# a subscription URL in this file or in a deployment package.

# GeminiAI sidecar: Docker Compose keeps this provider on its internal network
# (宝塔 host-network mode binds it to 127.0.0.1 only). Generate a dedicated
# value with `openssl rand -hex 32`; it must not be sent to browser clients.
DREAMYO_GEMINIAI_IMAGE=dreamyo-geminiai:local
DREAMYO_GEMINIAI_API_KEY=
# Docker Compose supplies the internal URL. Only source development should set
# this manually after starting a trusted local sidecar.
DREAMYO_GEMINIAI_URL=

# ChatGPT API：安装 services/chatgpt-api 的 Python 环境后由 pnpm start 自动托管。
# 设为 0 可禁用本地托管；设为 1 时缺少环境将明确报错。私有数据位于主数据目录/chatgpt-api。
DREAMYO_CHATGPT_API_ENABLED=
DREAMYO_CHATGPT_API_PORT=8046
DREAMYO_CHATGPT_API_PYTHON=
DREAMYO_CHATGPT_DATA_DIR=
# 仅连接已部署内部运行时时填写 URL 和至少 32 字符的服务密钥；切勿使用公开渠道密钥代替。
DREAMYO_CHATGPT_API_URL=
DREAMYO_CHATGPT_API_KEY=
# 可选：固定浏览器反代使用的 AI Studio 项目上下文，不需要 API Key
DREAMYO_GEMINIAI_STUDIO_URL=https://aistudio.google.com/prompts/new_chat?project=your-project-id

# GeminiTools uses the reference project's built-in Antigravity Enterprise OAuth
# client in the current browser popup. These two values are optional overrides.
GEMINI_TOOLS_OAUTH_CLIENT_ID=
GEMINI_TOOLS_OAUTH_CLIENT_SECRET=
# Optional with a custom OAuth client when the public callback differs from APP_URL.
GEMINI_TOOLS_OAUTH_REDIRECT_URI=

# 即梦官方 CLI 由 Web/Generation Worker 所在的服务账号本地执行。
# 留空时从 PATH 查找 dreamina；自定义位置必须填写绝对可执行文件路径。
DREAMYO_DREAMINA_CLI_PATH=
# 可选：受控素材暂存与异步结果下载目录；必须为绝对路径，默认使用系统临时目录。
DREAMYO_DREAMINA_CLI_TEMP_ROOT=

# Private or loopback model providers are blocked by default. Enable only for administrator-controlled hosts.
# Hosts are exact, comma-separated names or IP addresses; do not add cloud metadata or link-local addresses.
DREAMYO_ALLOW_PRIVATE_UPSTREAMS=0
DREAMYO_PRIVATE_UPSTREAM_HOSTS=

# Billing behavior.
DREAMYO_BILLING_ORDER_EXPIRES_MINUTES=30
# Optional token for deployment-neutral maintenance jobs. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`, then call maintenance APIs with `Authorization: Bearer <token>`.
DREAMYO_MAINTENANCE_TOKEN=
# Required by the generation Worker and internal per-user task callbacks. It must differ from the maintenance token.
DREAMYO_WORKER_TOKEN=
# Worker polls the internal endpoint. Docker Compose sets this to http://app:3000.
DREAMYO_WORKER_API_ORIGIN=
DREAMYO_GENERATION_WORKER_ID=
# Initial idle polling interval. Consecutive empty batches back off to 10000ms.
DREAMYO_GENERATION_WORKER_INTERVAL_MS=2000
DREAMYO_GENERATION_WORKER_LANES=2
DREAMYO_GENERATION_WORKER_HEARTBEAT_MS=15000
DREAMYO_GENERATION_WORKER_STALE_MS=90000

# Optional work-publication moderation signal provider. Signals never auto-approve content.
# manual: always requires an administrator review (default).
# keywords: checks the comma/newline-separated keyword list below.
# http: POSTs public draft fields to the configured endpoint with a 3-second timeout.
DREAMYO_CONTENT_MODERATION_PROVIDER=manual
DREAMYO_CONTENT_MODERATION_KEYWORDS=
DREAMYO_CONTENT_MODERATION_URL=
DREAMYO_CONTENT_MODERATION_API_KEY=

# Optional Stripe configuration. It can also be saved from the admin payment settings page.
DREAMYO_STRIPE_SECRET_KEY=
DREAMYO_STRIPE_WEBHOOK_SECRET=
DREAMYO_STRIPE_API_BASE=https://api.stripe.com
DREAMYO_STRIPE_SUCCESS_URL=
DREAMYO_STRIPE_CANCEL_URL=
DREAMYO_STRIPE_PAYMENT_METHOD_TYPES=
DREAMYO_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional Alipay configuration.
DREAMYO_ALIPAY_MODE=official
DREAMYO_ALIPAY_APP_ID=
DREAMYO_ALIPAY_PRIVATE_KEY=
DREAMYO_ALIPAY_PRIVATE_KEY_PATH=
DREAMYO_ALIPAY_PUBLIC_KEY=
DREAMYO_ALIPAY_PUBLIC_KEY_PATH=
DREAMYO_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
DREAMYO_ALIPAY_NOTIFY_URL=
DREAMYO_ALIPAY_RETURN_URL=

# Optional WeChat Pay v3 configuration.
DREAMYO_WECHAT_PAY_APP_ID=
DREAMYO_WECHAT_PAY_MCH_ID=
DREAMYO_WECHAT_PAY_CERT_SERIAL_NO=
DREAMYO_WECHAT_PAY_PRIVATE_KEY=
DREAMYO_WECHAT_PAY_PRIVATE_KEY_PATH=
DREAMYO_WECHAT_PAY_API_V3_KEY=
DREAMYO_WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
DREAMYO_WECHAT_PAY_PLATFORM_PUBLIC_KEY=
DREAMYO_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
DREAMYO_WECHAT_PAY_PLATFORM_CERTIFICATE=
DREAMYO_WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
DREAMYO_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
DREAMYO_WECHAT_PAY_NOTIFY_URL=
DREAMYO_WECHAT_PAY_REFUND_NOTIFY_URL=
DREAMYO_WECHAT_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# Optional PayPly/custom gateway configuration.
DREAMYO_PAYPLY_CHECKOUT_URL=
DREAMYO_PAYPLY_REFUND_URL=
DREAMYO_PAYPLY_API_KEY=
DREAMYO_PAYPLY_API_KEY_HEADER=
DREAMYO_PAYPLY_MERCHANT_ID=
DREAMYO_PAYPLY_REQUEST_METHOD=POST
DREAMYO_PAYPLY_CONTENT_TYPE=application/json
DREAMYO_PAYPLY_EXTRA_HEADERS=
DREAMYO_PAYPLY_REQUEST_TEMPLATE=
DREAMYO_PAYPLY_NOTIFY_URL=
DREAMYO_PAYPLY_RETURN_URL=
DREAMYO_PAYPLY_CANCEL_URL=
DREAMYO_PAYPLY_RESULT_KIND=
DREAMYO_PAYPLY_URL_FIELD=data.payUrl
DREAMYO_PAYPLY_QR_FIELD=data.qrContent
DREAMYO_PAYPLY_FORM_FIELD=data.formHtml
DREAMYO_PAYPLY_PROVIDER_ORDER_ID_FIELD=data.tradeId
DREAMYO_PAYPLY_PROVIDER_PAYMENT_ID_FIELD=data.paymentId
DREAMYO_PAYPLY_WEBHOOK_SECRET=
DREAMYO_PAYPLY_WEBHOOK_SIGNATURE_HEADER=x-signature
DREAMYO_PAYPLY_WEBHOOK_EVENT_ID_FIELD=id
DREAMYO_PAYPLY_WEBHOOK_EVENT_TYPE_FIELD=type
DREAMYO_PAYPLY_WEBHOOK_ORDER_ID_FIELD=data.orderId
DREAMYO_PAYPLY_WEBHOOK_ORDER_NO_FIELD=data.orderNo
DREAMYO_PAYPLY_WEBHOOK_STATUS_FIELD=data.status
DREAMYO_PAYPLY_WEBHOOK_SUCCESS_STATUSES=paid,success,succeeded,completed
DREAMYO_PAYPLY_WEBHOOK_TRADE_ID_FIELD=data.tradeId
DREAMYO_PAYPLY_WEBHOOK_PAYMENT_ID_FIELD=data.paymentId
DREAMYO_PAYPLY_WEBHOOK_AMOUNT_CENTS_FIELD=data.amountCents
DREAMYO_PAYPLY_WEBHOOK_AMOUNT_YUAN_FIELD=data.amount
DREAMYO_PAYPLY_WEBHOOK_CURRENCY_FIELD=data.currency
DREAMYO_PAYPLY_WEBHOOK_PAID_AT_FIELD=data.paidAt
DREAMYO_PAYPLY_REFUND_REQUEST_METHOD=POST
DREAMYO_PAYPLY_REFUND_CONTENT_TYPE=application/json
DREAMYO_PAYPLY_REFUND_EXTRA_HEADERS=
DREAMYO_PAYPLY_REFUND_REQUEST_TEMPLATE=
DREAMYO_PAYPLY_REFUND_ID_FIELD=data.refundId
DREAMYO_PAYPLY_REFUND_STATUS_FIELD=data.status
DREAMYO_PAYPLY_REFUND_SUCCESS_STATUSES=refunded,success,succeeded

# Generic signed callback fallback for /api/billing/webhooks/custom.
DREAMYO_PAYMENT_WEBHOOK_SECRET=

# GeminiTools（Antigravity 桌面 OAuth 客户端）凭据，仅服务端环境变量，不入库
GEMINI_TOOLS_OAUTH_CLIENT_ID=
GEMINI_TOOLS_OAUTH_CLIENT_SECRET=

# GeminiAIStudio 项目会话 URL
DREAMYO_GEMINIAI_STUDIO_URL=

