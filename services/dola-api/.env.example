# Private Camoufox Provider. Never expose this service or these values to a browser.
DOLA_PROVIDER_KEY=
DOLA_ENABLE_BROWSER=1
DOLA_WEB_URL=https://www.dola.com/chat/create-image
DOLA_BROWSER_ENGINE=camoufox
# Optional per-provider browser pin. Keep the global Camoufox active version free
# for GeminiAIStudio and other local providers.
DOLA_CAMOUFOX_BROWSER=
# Optional fingerprint constraints. When omitted, the target OS is macOS and
# the locale defaults to zh-CN. Each account receives a stable
# fingerprint preset under DOLA_PROFILE_DIR.
DOLA_CAMOUFOX_OS=
DOLA_CAMOUFOX_LOCALE=zh-CN

# Use a deployment secret so accepted task identities and refreshed cookies survive
# a provider restart. The provider key is only a development compatibility fallback.
DOLA_TASK_ENCRYPTION_KEY=
DOLA_TASK_STATE_PATH=/data/dola/task-state.json
DOLA_PROFILE_DIR=/data/dola/profiles
DOLA_PROVIDER_PORT=18082

# Outbound proxy selection is supplied per task by Next.js from the existing
# generic proxy management page. No Taiwan/IPWO-specific environment variable is used.
